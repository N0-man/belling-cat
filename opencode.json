{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "build": {
      "mode": "primary",
      "model": "github-copilot/claude-sonnet-4.5",
      "permission": {
        "edit": "allow",
        "bash": {
          "*": "allow"
        },
        "task": {
          "*": "deny",
          "standards-reviewer": "allow",
          "spec-reviewer": "allow",
          "architecture-reviewer": "allow",
          "code-auditor": "allow",
          "traceability-auditor": "allow"
        }
      }
    },
    "plan": {
      "mode": "primary",
      "model": "github-copilot/claude-sonnet-4.5",
      "permission": {
        "edit": "allow",
        "bash": {
          "*": "allow"
        },
        "task": "deny"
      }
    }
  },
  "permission": {
    "*": "ask",
    "read": "allow",
    "grep": "allow",
    "glob": "allow",
    "list": "allow",
    "edit": "ask",
    "todowrite": "allow",
    "webfetch": "deny",
    "websearch": "deny",
    "lsp": "allow",
    "question": "allow",
    "task": "ask",
    "skill": {
      "*": "allow"
    },
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git rev-parse*": "allow",
      "git merge-base*": "allow",
      "make test": "allow",
      "make lint": "allow",
      "make lint-fix": "allow",
      "make format": "allow",
      "make format-check": "allow",
      "make typecheck": "allow",
      "make preflight": "allow",
      "make eval": "allow",
      "make workflow-lint": "allow",
      "python scripts/validate_agent_workflow.py*": "allow"
    }
  }
}
